<Project>

  <ItemGroup Condition="'$(IncludeDiagnostics)' == 'true'">
    <ProjectReference
      Include="$(MSBuildThisFileDirectory)src/Qowaiv.Diagnostics.Contracts/Qowaiv.Diagnostics.Contracts.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeGuard)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)shared/Guard.cs" Link="Properties/Guard.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(IncludeLock)' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)shared/Lock.cs" Link="Properties/Lock.cs" />
  </ItemGroup>

</Project>
