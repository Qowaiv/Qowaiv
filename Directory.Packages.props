<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <CentralPackageVersionOverrideEnabled>true</CentralPackageVersionOverrideEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="AwesomeAssertions.Analyzers" Version="9.0.8" />
    <!-- linked to Roslyn version -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.16.0-preview.2" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="IbanNet" Version="6.2.1" />
    <PackageVersion Include="MathNet.Numerics" Version="5.0.0" />
    <!-- Roslyn .NET 8 -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="[5.9.0]" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Sbom.Targets" Version="4.1.13" />
    <PackageVersion Include="MiniValidation" Version="0.10.0" />
    <PackageVersion Include="MongoDB.Analyzer" Version="2.0.0" />
    <PackageVersion Include="MongoDB.Bson" Version="3.13.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="StyleCop.Analyzers.Unstable" Version="1.2.0.556" />
    <PackageVersion Include="System.ComponentModel.Annotations" Version="5.0.0" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Memory.Data" Version="11.0.0" />
    <PackageVersion Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="TUnit" Version="1.83.0" />
    <PackageVersion Include="TUnit.Core" Version="1.81.16" />
  </ItemGroup>
  <ItemGroup>
    <GlobalPackageReference Include="AsyncFixer" Version="2.1.0" />
    <GlobalPackageReference Include="DotNet.ReproducibleBuilds" Version="2.0.5" />
    <GlobalPackageReference Include="DotNetProjectFile.Analyzers" Version="1.19.1" />
    <GlobalPackageReference Include="PolySharp" Version="1.17.0" />
    <GlobalPackageReference Include="Qowaiv.Analyzers.CSharp" Version="2.8.0" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>
  <ItemGroup>
    <ThirdPartyLicense Include="Microsoft.Data.*" Hash="cIjQ_8Sqlg6H63E6ArliXg" />
    <ThirdPartyLicense Include="SonarAnalyzer.CSharp" Hash="IBM9yngU7omFyJOMSFSy0w" />
  </ItemGroup>
</Project>