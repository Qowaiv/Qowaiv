<Project>

  <!--
    Opt-in .NET Framework 4.8 target for test projects, to run the
    netstandard2.0 code paths of the libraries. It requires Windows, and is
    enabled with: -p:TestNetFramework=true

    Import this file at the END of the project file, so that TargetFrameworks
    is already defined.

    These are test projects only: the net48 restore is not locked, as NuGet
    locked mode requires the lock file to match the set of target frameworks.
    The lock file is redirected to the (untracked) obj folder, so the committed
    packages.lock.json files are left alone.
  -->
  <PropertyGroup Condition="'$(TestNetFramework)' == 'true'">
    <TargetFrameworks>$(TargetFrameworks);net48</TargetFrameworks>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/obj/packages.net48.lock.json</NuGetLockFilePath>
    <RestoreLockedMode>false</RestoreLockedMode>
  </PropertyGroup>

  <!-- Code generation specs rely on APIs that are not available on .NET Framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Compile Remove="**/*_generation.cs" />
  </ItemGroup>

</Project>