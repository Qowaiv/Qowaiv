<Project>

  <Import Project="../props/package.props" />
  <Import Project="../shared/Qowaiv.Json.Shared/Qowaiv.Json.Shared.props" />

  <PropertyGroup Label="Package info">
    <ProductName>Qowaiv JSON</ProductName>
    <Description>Provides convention based JSON converters to work with SVOs.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileFullPath)" Link="Properties/$(MSBuildThisFile)" />
  </ItemGroup>
  
</Project>
