<Project>

  <Import Project="../props/package.props" />

  <PropertyGroup Label="Package info">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageIcon>package-icon-validation.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileFullPath)" Link="Properties/$(MSBuildThisFile)" />
  </ItemGroup>
  
</Project>
