<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../props/nopackage.props" />

  <PropertyGroup>
    <OutputType>exe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <!-- We do not care about strong names for benchmarking -->
    <NoWarn>$(NoWarn);CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="IbanNet" />
    <PackageReference Include="MathNet.Numerics" />
  </ItemGroup>

  <ItemGroup Label="Analyzers">
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Qowaiv/Qowaiv.csproj" />
    <ProjectReference Include="../Qowaiv.TestTools/Qowaiv.TestTools.csproj" />
    <ProjectReference Include="../Specs.Generated/Specs.Generated.csproj" />
  </ItemGroup>

</Project>
