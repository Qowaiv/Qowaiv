<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../props/package-validation.props" />

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <PackageId>Qowaiv.Validation.Microsoft</PackageId>
    <!-- New package: no previously released stable version to validate against. -->
    <NoWarn>$(NoWarn);Proj0241</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Qowaiv.Validation.Abstractions/Qowaiv.Validation.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Validation" />
  </ItemGroup>

  <PropertyGroup>
    <ToBeReleased>
      <![CDATA[
v11.*
- Initial version.
]]>
    </ToBeReleased>
    <PackageReleaseNotes>
      <![CDATA[
v11.0.0
- Initial version.
]]>
    </PackageReleaseNotes>
  </PropertyGroup>

</Project>
