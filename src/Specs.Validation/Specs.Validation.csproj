<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../props/specs.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <RootNamespace>Specs</RootNamespace>
    <NoWarn>$(NoWarn);CA1824;CA1861;CS8002</NoWarn>
  </PropertyGroup>

  <ItemGroup Label="XML files as embedded">
    <EmbeddedResource Include="Xml/Files/*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="TestMessages.Designer.cs" DependentUpon="TestMessages.resx" DesignTime="True" AutoGen="True" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="TestMessages.resx" LastGenOutput="TestMessages.Designer.cs" Generator="ResXFileCodeGenerator" />
  </ItemGroup>

  <ItemGroup Label="Projects under test">
    <ProjectReference Include="../Qowaiv.Validation.DataAnnotations/Qowaiv.Validation.DataAnnotations.csproj" />
    <ProjectReference Include="../Qowaiv.Validation.Fluent/Qowaiv.Validation.Fluent.csproj" />
    <ProjectReference Include="../Qowaiv.Validation.Guarding/Qowaiv.Validation.Guarding.csproj" />
    <ProjectReference Include="../Qowaiv.Validation.Messages/Qowaiv.Validation.Messages.csproj" />
    <ProjectReference Include="../Qowaiv.Validation.TestTools/Qowaiv.Validation.TestTools.csproj" />
    <ProjectReference Include="../Qowaiv.Validation.Xml/Qowaiv.Validation.Xml.csproj" />
  </ItemGroup>

  <ItemGroup Label="Test Tools">
    <ProjectReference Include="../Specs.Shared/Specs.Shared.csproj" />
    <ProjectReference Include="../Specs.Validation.TestData/Specs.Validation.TestData.csproj" />
  </ItemGroup>

  <ItemGroup Label="Depedencies">
    <PackageReference Include="FluentValidation" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="MiniValidation" />
    <PackageReference Include="System.Memory.Data" />
  </ItemGroup>

</Project>
